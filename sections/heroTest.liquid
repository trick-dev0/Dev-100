<div class="containerHeroTest">
    <div class="infoTextTop">
        <h2> {{ section.settings.title }}</h2>
        <p>{{ section.settings.text }}</p>
    </div>
    <div class="productInfo">
        {% if product %}
            <div class="productInfoText">
                <h3>{{ product.title }}</h3>
                <p>{{ product.price |  money }}</p>
            </div>
            <div class="productInfoRender">
                {{ product.featured_image   | image_url: width: 300 | image_tag: alt: product.title, loading: 'lazy' }}
                {{ product.description }}
            </div>
        {% endif %}
    </div>

    {% if product %}
        {% render 'product-card', product: product %}
    {% endif %}

</div>




<style>
    .containerHeroTest{
        margin-top: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: {{section.settings.bg_color}};
        color: #fff;
        border-radius: 10px;
        padding: 20px;
    }

    .infoTextTop{
        background-color: {{ section.settings.bg_color_text }};
        border-radius: 10px;
        padding: 10px;
    }

    .infoTextTop h2{
        text-align: center;
        padding-bottom: 10px;
    }

    .productInfo{
        background-color: #E8EDF2;
        color: #2C3947;
        display: flex;
        align-items: center;
        border-radius: 10px;
        margin-top: 20px;
    }

    .productInfoText{
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #C2A56D;
        padding: 30px 10px;
        margin: 0 0 0 10px;;
    }

    .productInfoRender{

    }
</style>


{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "This Page is very good!!"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Lorem Ipsum..."
    },
    {
      "type": "color",
      "id": "bg_color_text",
      "label": "Cor de fundo do texto",
      "default": "#2C3947"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo do fundo",
      "default": "#2C3947"
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Mostrar produto",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
